rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
                    && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId)
                    && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // User saved templates subcollection
      match /savedTemplates/{templateId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(templateId)
                      && incoming().userId == request.auth.uid
                      && incoming().id is string
                      && incoming().name is string
                      && incoming().name.size() <= 100;
        allow update: if isOwner(userId)
                      && incoming().userId == existing().userId
                      && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }

      // User brand profiles subcollection
      match /brandProfiles/{brandId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(brandId)
                      && incoming().userId == request.auth.uid
                      && incoming().id is string
                      && incoming().name is string
                      && incoming().name.size() <= 100;
        allow update: if isOwner(userId)
                      && incoming().userId == existing().userId
                      && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }

      // User publications subcollection
      match /publications/{publicationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(publicationId)
                      && incoming().userId == request.auth.uid
                      && incoming().id is string
                      && incoming().title is string
                      && incoming().title.size() <= 150;
        allow update: if isOwner(userId)
                      && incoming().userId == existing().userId
                      && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }

      // User media assets subcollection
      match /media/{mediaId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(mediaId)
                      && incoming().userId == request.auth.uid
                      && incoming().id is string
                      && incoming().name is string
                      && incoming().name.size() <= 128;
        allow update: if isOwner(userId)
                      && incoming().userId == existing().userId
                      && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }

      // User active workspace state
      match /workspace/{workspaceId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(workspaceId)
                              && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // User custom clubs and shields subcollection
      match /customClubs/{clubId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(clubId)
                      && incoming().userId == request.auth.uid
                      && incoming().id is string
                      && incoming().name is string
                      && incoming().name.size() <= 120;
        allow update: if isOwner(userId)
                      && incoming().userId == existing().userId
                      && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }
    }
  }
}
